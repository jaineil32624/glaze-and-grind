; Engine configuration file.
; Glaze & Grind — donut & coffee shop tycoon

config_version=5

[application]

config/name="Glaze & Grind"
config/description="Run a bustling donut and coffee shop: autonomous crew, rush hours, upgrades and expansion."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"
boot_splash/bg_color=Color(1, 0.94, 0.86, 1)
boot_splash/show_image=false

[autoload]

Bus="*res://scripts/autoload/event_bus.gd"
DB="*res://scripts/autoload/data_registry.gd"
Game="*res://scripts/autoload/game_state.gd"
Saves="*res://scripts/autoload/save_system.gd"
Sfx="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.99, 0.93, 0.85, 1)
anti_aliasing/quality/msaa_2d=1
